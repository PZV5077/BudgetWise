# ============================================================
#  BudgetWise — 配置文件 (Configuration)
#  
#  ⚠️ 重要：请复制此文件为 .env，然后填写下面的值
#  ⚠️ IMPORTANT: Copy this file to .env and fill in the values
#
#  操作步骤 (Steps):
#    1. 复制文件: cp .env.example .env
#    2. 用文本编辑器打开 .env 文件
#    3. 将下面的 "在这里填写xxx" 替换为你的实际值
#    4. 保存文件，然后运行: npm run dev
# ============================================================

# --- 服务器端口 (Server Port) ---
# 默认3000，一般不需要改
PORT=3000

# --- JWT 密钥 (JWT Secret Key) ---
# 用于用户登录令牌加密，请设置一个随机的长字符串
# 例如：mySecretKey123456789
JWT_SECRET=在这里填写一个随机密钥字符串

# --- 数据库配置 (Database Configuration) ---
# 请填写你的云数据库连接信息
# 如果使用 MySQL:
DB_TYPE=sqlite
DB_HOST=在这里填写数据库地址
DB_PORT=3306
DB_NAME=budgetwise
DB_USER=在这里填写数据库用户名
DB_PASSWORD=在这里填写数据库密码

# --- OpenAI API 配置 (AI Chat Configuration) ---
# 用于AI省钱建议聊天机器人
# 获取方式：访问 https://platform.openai.com/api-keys 创建API Key
OPENAI_API_KEY=在这里填写你的OpenAI-API-Key
OPENAI_MODEL=gpt-3.5-turbo

# --- Duo Mobile 2FA 配置 (Duo Authentication) ---
# 获取方式：登录 https://admin.duosecurity.com 创建应用后获取
# 如果暂时不使用Duo，可以保持 DUO_ENABLED=false
DUO_ENABLED=false
DUO_CLIENT_ID=在这里填写Duo-Client-ID
DUO_CLIENT_SECRET=在这里填写Duo-Client-Secret
DUO_API_HOSTNAME=在这里填写Duo-API-Hostname
DUO_REDIRECT_URI=http://localhost:3000/api/auth/duo-callback
